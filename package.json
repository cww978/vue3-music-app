{
  "name": "vue3-music-app",
  "version": "1.0.0",
  "description": "Music player desktop app built with Electron, Vue3, and TypeScript",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "build:unpacked": "electron-builder --dir --publish never --config electron.builder.config.json",
    "pack:win": "electron-vite build && electron-builder --win",
    "pack:mac": "electron-vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.demo.app",
    "productName": "DemoApp",

    "directories": {
      "output": "release"
    },

    "files": [
      "dist",
      "out"
    ],

    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@icon-park/vue-next": "^1.3.6",
    "axios": "^0.26.0",
    "dayjs": "^1.10.8",
    "element-plus": "^2.0.4",
    "lodash": "^4.17.21",
    "pinia": "^2.0.11",
    "swiper": "^8.0.6",
    "vue": "^3.5.0",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/lodash": "^4.14.179",
    "@types/lodash-es": "*",
    "@types/node": "^25.6.2",
    "@vitejs/plugin-vue": "^5.1.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/tsconfig": "^0.1.3",
    "@vueuse/core": "^10.0.0",
    "autoprefixer": "^10.4.2",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.14",
    "sass": "^1.99.0",
    "tailwindcss": "^3.0.23",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^7.3.3",
    "vue-tsc": "^3.2.8"
  }
}
